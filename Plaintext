<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DBL Trading | منصة تحليل وتداول الذهب</title>
  
  <!-- خط Cairo من Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- FontAwesome للايقونات -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Chart.js للرسم البياني -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <!-- Tailwind CSS عبر CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            cairo: ['Cairo', 'sans-serif'],
          },
          colors: {
            dbl: {
              bg: '#070a13',
              card: 'rgba(15, 23, 42, 0.75)',
              border: 'rgba(255, 255, 255, 0.1)',
              accent: '#3b82f6',
              gold: '#eab308',
              goldglow: '#f59e0b',
              bullish: '#10b981',
              bearish: '#ef4444'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Cairo', sans-serif;
      background: radial-gradient(circle at 50% -20%, #1e1b4b 0%, #070a13 70%);
      color: #f3f4f6;
      min-height: 100vh;
    }
    .glass-panel {
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }
    .glass-panel-gold {
      background: linear-gradient(135deg, rgba(234, 179, 8, 0.08) 0%, rgba(15, 23, 42, 0.8) 100%);
      border: 1px solid rgba(234, 179, 8, 0.2);
    }
    .text-glow-gold {
      text-shadow: 0 0 12px rgba(234, 179, 8, 0.5);
    }
    .text-glow-green {
      text-shadow: 0 0 12px rgba(16, 185, 129, 0.5);
    }
    .glow-box-green {
      box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);
    }
  </style>
</head>
<body class="p-3 md:p-6 pb-12">

  <!-- Header -->
  <header class="glass-panel rounded-2xl p-4 mb-6 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-yellow-600 to-yellow-300 flex items-center justify-center shadow-lg shadow-yellow-500/20 text-slate-950 font-black text-2xl tracking-widest">
        DBL
      </div>
      <div>
        <h1 class="text-xl md:text-2xl font-black text-white flex items-center gap-2">
          منصة DBL لإنذارات وسلوك الذهب
          <span class="text-xs bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 px-2 py-0.5 rounded-full font-bold">إصدار التداول V2</span>
        </h1>
        <p class="text-xs text-slate-400">تحليل السيولة الشامل ومؤشرات التحركات اللحظية</p>
      </div>
    </div>

    <!-- Live Control Tools -->
    <div class="flex items-center gap-3 bg-slate-900/80 p-1.5 rounded-xl border border-slate-800">
      <button id="toggleSimBtn" onclick="toggleSimulation()" class="px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/30 transition text-xs font-bold flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        تحديث الأسعار التلقائي: نشط
      </button>
      <div class="text-xs text-slate-400 border-r border-slate-700 pr-3 mr-1">
        سعر الذهب الحالي: <span id="headerPrice" class="font-bold text-yellow-400">4019.435</span>
      </div>
    </div>
  </header>

  <!-- Main Grid Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- RIGHT COLUMN: Targets & Liquidity (Span 4) -->
    <div class="lg:col-span-4 space-y-6">

      <!-- Status Summary Card -->
      <div class="glass-panel-gold rounded-2xl p-5 relative overflow-hidden">
        <div class="absolute -top-10 -left-10 w-32 h-32 bg-yellow-500/10 rounded-full blur-2xl"></div>
        <div class="flex justify-between items-start mb-4">
          <div>
            <span class="text-xs font-semibold text-slate-400 block mb-1">حالة الاتجاه العام</span>
            <div class="text-2xl font-black text-emerald-400 text-glow-green flex items-center gap-2">
              <i class="fa-solid fa-arrow-trend-up"></i> اتجاه صاعد قوي
            </div>
          </div>
          <span class="bg-emerald-500/20 text-emerald-300 text-xs font-bold px-3 py-1 rounded-full border border-emerald-500/30">
            فوق 4004.100
          </span>
        </div>

        <div class="grid grid-cols-2 gap-3 pt-3 border-t border-slate-800/80">
          <div class="bg-slate-900/60 p-3 rounded-xl">
            <span class="text-[11px] text-slate-400 block">السعر اللحظي</span>
            <span id="currentPriceDisplay" class="text-lg font-bold text-yellow-400 text-glow-gold">4019.435</span>
          </div>
          <div class="bg-slate-900/60 p-3 rounded-xl">
            <span class="text-[11px] text-slate-400 block">التغير اليومي</span>
            <span class="text-lg font-bold text-emerald-400">+18.675</span>
          </div>
        </div>
      </div>

      <!-- Liquidity Targets Box -->
      <div class="glass-panel rounded-2xl p-5">
        <h2 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4 flex items-center justify-between">
          <span><i class="fa-solid fa-bullseye text-yellow-400 ml-2"></i>أهداف السيولة المستهدفة فوق السعر</span>
          <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded">DBL Core</span>
        </h2>

        <div class="space-y-3">

          <!-- Target 1 -->
          <div class="bg-slate-900/50 hover:bg-slate-800/50 transition border border-slate-800 p-3.5 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center text-yellow-400 text-xs font-bold">
                1
              </div>
              <div>
                <div class="text-sm font-bold text-white">قمة لندن</div>
                <div class="text-xs text-slate-400">يبعد <span class="text-yellow-400 font-semibold">+2.965</span> نقطة</div>
              </div>
            </div>
            <div class="text-left">
              <div class="text-base font-black text-yellow-400">4022.400</div>
              <div class="text-[11px] text-emerald-400 font-bold">فرصة الوصول 92%</div>
            </div>
          </div>

          <!-- Target 2 -->
          <div class="bg-slate-900/50 hover:bg-slate-800/50 transition border border-slate-800 p-3.5 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center text-yellow-400 text-xs font-bold">
                2
              </div>
              <div>
                <div class="text-sm font-bold text-white">قمة أمس</div>
                <div class="text-xs text-slate-400">يبعد <span class="text-yellow-400 font-semibold">+14.585</span> نقطة</div>
              </div>
            </div>
            <div class="text-left">
              <div class="text-base font-black text-yellow-400">4034.020</div>
              <div class="text-[11px] text-emerald-400 font-bold">فرصة الوصول 80%</div>
            </div>
          </div>

          <!-- Target 3 -->
          <div class="bg-slate-900/50 hover:bg-slate-800/50 transition border border-slate-800 p-3.5 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center text-yellow-400 text-xs font-bold">
                3
              </div>
              <div>
                <div class="text-sm font-bold text-white">قمة الأسبوع الماضي</div>
                <div class="text-xs text-slate-400">يبعد <span class="text-yellow-400 font-semibold">+170.955</span> نقطة</div>
              </div>
            </div>
            <div class="text-left">
              <div class="text-base font-black text-yellow-400">4190.390</div>
              <div class="text-[11px] text-slate-400">فرصة الوصول 40%</div>
            </div>
          </div>

          <!-- Target 4 -->
          <div class="bg-slate-900/50 hover:bg-slate-800/50 transition border border-slate-800 p-3.5 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center text-yellow-400 text-xs font-bold">
                4
              </div>
              <div>
                <div class="text-sm font-bold text-white">قمة الشهر الماضي</div>
                <div class="text-xs text-slate-400">يبعد <span class="text-yellow-400 font-semibold">+491.485</span> نقطة</div>
              </div>
            </div>
            <div class="text-left">
              <div class="text-base font-black text-yellow-400">4510.920</div>
              <div class="text-[11px] text-slate-400">فرصة الوصول 40%</div>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- CENTER COLUMN: Interactive Chart & Analysis (Span 8) -->
    <div class="lg:col-span-8 space-y-6">

      <!-- Chart Panel -->
      <div class="glass-panel rounded-2xl p-5 relative">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-chart-line text-blue-400"></i> شارت المسار والسيناريو المتوقع (DBL Engine)
            </h2>
            <p class="text-xs text-slate-400">فريم 15 دقيقة مع تحديد خطوط السيولة والقمم السابقة</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="switchChartScenario('bullish')" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/30">المسار الصاعد</button>
            <button onclick="switchChartScenario('bearish')" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-red-500/20 text-red-300 border border-red-500/30 hover:bg-red-500/30">المسار الهابط</button>
            <button onclick="switchChartScenario('both')" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 hover:bg-blue-500/30">عرض الاثنين</button>
          </div>
        </div>

        <!-- Chart Container -->
        <div class="h-[360px] w-full relative">
          <canvas id="dblMainChart"></canvas>
        </div>
      </div>

      <!-- Additional Market Data Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="glass-panel p-4 rounded-xl">
          <span class="text-xs text-slate-400 block mb-1">افتتاح اليوم</span>
          <span class="text-lg font-bold text-white">4000.760</span>
        </div>
        <div class="glass-panel p-4 rounded-xl">
          <span class="text-xs text-slate-400 block mb-1">قاع أمس المعياري</span>
          <span class="text-lg font-bold text-slate-300">3975.670</span>
        </div>
        <div class="glass-panel p-4 rounded-xl">
          <span class="text-xs text-slate-400 block mb-1">متوسط حركة الشمعة (15 دقيقة)</span>
          <span class="text-lg font-bold text-yellow-400">7.622 نقطة</span>
        </div>
      </div>

    </div>

  </div>

  <script>
    // --- JavaScript Engine for DBL Platform ---
    let simActive = true;
    let currentPrice = 4019.435;
    let chartInstance = null;

    // Initialize Chart
    function initDBLChart() {
      const ctx = document.getElementById('dblMainChart').getContext('2d');
      
      const labels = ['09:00', '09:15', '09:30', '09:45', '10:00', '10:15 (الآن)', 'الهدف 1', 'الهدف 2'];
      const mainData = [4008, 4010, 4005, 4012, 4015, currentPrice, null, null];
      const bullishPath = [null, null, null, null, null, currentPrice, 4022.400, 4034.020];
      const bearishPath = [null, null, null, null, null, currentPrice, 4003.430, 3982.870];

      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'حركة السعر الفعلية',
              data: mainData,
              borderColor: '#3b82f6',
              borderWidth: 3,
              tension: 0.3,
              pointBackgroundColor: '#3b82f6',
              pointRadius: 4
            },
            {
              label: 'المسار الصاعد المتوقع',
              data: bullishPath,
              borderColor: '#10b981',
              borderWidth: 2,
              borderDash: [5, 5],
              tension: 0.2,
              pointBackgroundColor: '#10b981'
            },
            {
              label: 'المسار الهابط البديل',
              data: bearishPath,
              borderColor: '#ef4444',
              borderWidth: 2,
              borderDash: [5, 5],
              tension: 0.2,
              pointBackgroundColor: '#ef4444'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: { color: '#94a3b8', font: { family: 'Cairo' } }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#94a3b8', font: { family: 'Cairo' } }
            },
            y: {
              grid: { color: 'rgba(255, 255, 255, 0.05)' },
              ticks: { color: '#94a3b8', font: { family: 'Cairo' } }
            }
          }
        }
      });
    }

    // Live Tick Simulation Function
    function toggleSimulation() {
      simActive = !simActive;
      const btn = document.getElementById('toggleSimBtn');
      if (simActive) {
        btn.className = "px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/30 transition text-xs font-bold flex items-center gap-2";
        btn.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> تحديث الأسعار التلقائي: نشط`;
      } else {
        btn.className = "px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 border border-slate-700 hover:bg-slate-700 transition text-xs font-bold flex items-center gap-2";
        btn.innerHTML = `<span class="w-2 h-2 rounded-full bg-slate-500"></span> التحديث التلقائي: متوقف`;
      }
    }

    setInterval(() => {
      if (!simActive) return;
      const delta = (Math.random() - 0.48) * 0.45;
      currentPrice = parseFloat((currentPrice + delta).toFixed(3));
      
      document.getElementById('headerPrice').innerText = currentPrice;
      document.getElementById('currentPriceDisplay').innerText = currentPrice;

      if (chartInstance) {
        chartInstance.data.datasets[0].data[5] = currentPrice;
        chartInstance.data.datasets[1].data[5] = currentPrice;
        chartInstance.data.datasets[2].data[5] = currentPrice;
        chartInstance.update('none');
      }
    }, 2000);

    function switchChartScenario(mode) {
      if (!chartInstance) return;
      if (mode === 'bullish') {
        chartInstance.data.datasets[1].hidden = false;
        chartInstance.data.datasets[2].hidden = true;
      } else if (mode === 'bearish') {
        chartInstance.data.datasets[1].hidden = true;
        chartInstance.data.datasets[2].hidden = false;
      } else {
        chartInstance.data.datasets[1].hidden = false;
        chartInstance.data.datasets[2].hidden = false;
      }
      chartInstance.update();
    }

    window.onload = function() {
      initDBLChart();
    };
  </script>
</body>
</html>
